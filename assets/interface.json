{
    "interface_version": 2,
    "name": "MaaZZZ",
    "label": "绝区零驱动盘助手",
    "description": "使用 MaaFramework 执行绝区零驱动盘仓库扫描，并保留本地配装优化功能。",
    "contact": "local",
    "license": "MIT",
    "welcome": "欢迎使用绝区零驱动盘助手。",
    "version": "0.1.0",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": ".*绝区零.*|.*Zenless.*|.*ZZZ.*",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessage"
            }
        },
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "扫描驱动盘",
            "entry": "ScanDisks"
        }
    ]
}
